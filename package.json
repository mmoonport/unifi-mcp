{
  "name": "unifi-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "A small MCP server for a UniFi gateway's local API: read tools, and write tools that are off unless enabled and need an explicit confirmation.",
  "type": "module",
  "bin": {
    "unifi-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
